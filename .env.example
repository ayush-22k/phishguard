# Required for Phase 1 backend startup
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Neon pooled PostgreSQL connection string. Do not add real credentials to this file.
DATABASE_URL=
# Required for authentication. Use distinct random values of at least 32 characters.
JWT_SECRET=
JWT_REFRESH_SECRET=
# Optional authentication lifetime configuration.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

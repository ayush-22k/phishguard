# Backend-local convenience template. Keep values identical to the root template.
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Neon pooled PostgreSQL connection string. Do not add real credentials to this file.
DATABASE_URL=
# Required for authentication. Use distinct random values of at least 32 characters.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Rate Limiting
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=10
RATE_LIMIT_SCAN=50

# Gemini API Integration
GEMINI_API_KEY=
